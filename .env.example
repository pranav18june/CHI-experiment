# ── Server (Vercel project environment variables) ───────────────────────────
# MongoDB connection string. Size the Atlas tier for concurrent CONNECTIONS
# (instances x MONGODB_MAX_POOL_SIZE), not for data volume.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/decision_study

# Admin API credential. REQUIRED, 20+ chars — the API fails closed (503) when
# unset. Leave BLANK here: this file is committed, so any value in it ends up in
# public git history and invites copy-paste into a real deployment.
# Generate one with:  openssl rand -base64 32
ADMIN_SECRET=

# Comma-separated origins permitted to call the API cross-origin. Leave unset
# for same-origin-only, which is correct for a single-domain deployment.
STUDY_ALLOWED_ORIGINS=

# Primary outcome weighting (§5.10). Keep in sync with the VITE_ pair below.
STOCKOUT_PENALTY_WEIGHT=1.85
HOLDING_PENALTY_WEIGHT=1.0

# Pre-registered per-trial time floor (§9). Trials below this are flagged, not dropped.
MIN_TRIAL_DURATION_MS=8000

# Ingest hardening (optional; defaults shown)
MAX_EVENTS_PER_REQUEST=100
MAX_EVENT_PAYLOAD_BYTES=524288
MONGODB_MAX_POOL_SIZE=10

# ── Client (build-time, baked into the bundle) ──────────────────────────────
# MUST be unset or false for the participant-facing build. When true, ?condition=
# and ?trial= override the between-subjects manipulation from the URL.
VITE_ALLOW_URL_OVERRIDES=false

# Keep numerically identical to the server pair above.
VITE_STOCKOUT_PENALTY_WEIGHT=1.85
VITE_HOLDING_PENALTY_WEIGHT=1.0

VITE_MIN_TRIAL_DURATION_MS=8000
VITE_COMPREHENSION_PASS_THRESHOLD=4
VITE_STUDY_VERSION=4.1.0
